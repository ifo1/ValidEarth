@article{Gritto_etal_2004,
author = {Gritto, Roland and Romero, Arturo E. and Daley, Thomas M.},
title = {Results of a VSP experiment at the Resurgent Dome, Long Valley caldera, California},
journal = {Geophysical Research Letters},
volume = {31},
number = {6},
pages = {},
doi = {https://doi.org/10.1029/2004GL019451},
url = {https://agupubs.onlinelibrary.wiley.com/doi/abs/10.1029/2004GL019451},
eprint = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2004GL019451},
abstract = {A vertical seismic profiling experiment has been conducted at the DOE well LVF 51-20 at the resurgent dome at Long Valley caldera, California. The current paper is intended to report the velocity results derived from this experiment to seismically constrain the area around the resurgent dome. We report the results of velocity logs, Vp/Vs ratios, and VpVs products for the depth interval from 880-1980 m. The Bishop tuff can be divided into three zones (top-to-bottom) of intermediate velocities (Vp ≈ 4.0 km/s, Vs ≈ 2.3 km/s), followed by higher velocities (Vp = 4.7 km/s, Vs = 2.9 km/s) in the lower-central part, and a decrease back to the lower values at the bottom of the sequence. The analysis of VpVs data suggested a decrease in porosity in the lower-central section of the tuff as a possible explanation, which was supported by direct density measurements from a nearby location.},
year = {2004}
}

